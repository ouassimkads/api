{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "skipLibCheck": true,

    "types": ["node", "express"]
  },

  "include": ["src/**/*.ts", "generated/**/*.ts"],

  "exclude": ["node_modules", "dist"]
}
